NODE_ENV=production
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_DB_HOST:5432/mendcrew?schema=public
PORT=3000
AUTH_MODE=otp
SESSION_HOURS=24
CORS_ORIGINS=https://staff.your-domain.example
OTP_PROVIDER_URL=https://your-otp-adapter.example
OTP_PROVIDER_TOKEN=REPLACE_WITH_SERVER_ONLY_SECRET
# Replace these with approved business rules. Blank values are intentionally unusable.
WORKING_HOUR_START=
WORKING_HOUR_END=
BOOKING_LEAD_MINUTES=
CANCELLATION_LEAD_MINUTES=
SUPPORT_CONTACT=
PILOT_RULES_CONFIRMED=false
